{
  "name": "@ragers/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ragers Engine \u2014 canonical Rage/Rave/Experience runtime. Internal; not a public surface.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test \"tests/unit/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "certify": "node scripts/certify.ts",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "worker": "node scripts/worker.ts",
    "test:e2e": "playwright test",
    "lint": "node scripts/lint.ts",
    "migrate": "node scripts/migrate.ts",
    "test:live": "node --test \"tests/live/**/*.test.ts\"",
    "test:all": "npm run test && npm run test:live"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "5.9"
  },
  "dependencies": {
    "next": "^15.1.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
